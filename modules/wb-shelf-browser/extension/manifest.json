{
  "manifest_version": 3,
  "name": "Полки WB — сбор для книг",
  "version": "1.3.0",
  "description": "Одной кнопкой обновляет все книги полок и цен WB: снимает позиции наших карточек в полках конкурентов и цены на открытой вкладке wildberries.ru.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.wildberries.ru/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wildberries.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Полки WB: обновить все книги",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}